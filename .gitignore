# Generated analysis artifacts — rebuild with the commands in README.md.
# Kept out of git because they are derived from the screenshots, which are the
# real inputs.
screenshot-metrics.json
comparison-data.json
quality-ratings.json
verification/

# Per-attempt verification output. extract_metrics.py reads only the *top-level*
# "Screenshot From *.png" in each attempt directory (a non-recursive *.png glob),
# so screenshots a model took of its own report live under these directories,
# count as output rather than input, and are regenerated by that attempt's own
# build/verify script. The exceptions below are the only source files any attempt
# happened to keep inside an output directory.
**/.build/*
!**/.build/report_template.html
**/.verify/
**/shots/
**/verify-shots/

# jaaicode local session state (contains prompt history; never commit).
.jaaicode/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
*.egg-info/

# Tool output, recreated on demand.
graphify-out/

# Editor / OS noise.
.DS_Store
Thumbs.db
*.swp
